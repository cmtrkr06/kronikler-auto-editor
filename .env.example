# Copy to .env (never commit .env). Real values go only in .env / GitHub Secrets.
GEMINI_API_KEY=            # ayrı Google projesi (Zapyus kotasını yemez)
BLOGGER_ID=                # Otomobil Kronikleri blog ID
# Optional; defaults live in config.py
KRONIKLER_MEMORY_PATH=data/memory.json
KRONIKLER_REQUEST_TIMEOUT=15
KRONIKLER_DOMAIN_DELAY=2
KRONIKLER_LOG_LEVEL=INFO
